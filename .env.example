# Copy this file to .env for local development, and add the same keys to
# your Vercel project under Settings -> Environment Variables for production.

# --- Client-side (exposed to the browser — must be prefixed VITE_) ---------
# Supabase Project Settings -> API -> Project URL / anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (used by the /api serverless functions) --------------
# Supabase Project Settings -> API -> service_role key. NEVER expose this to
# the client or prefix it with VITE_ — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Developers -> API keys -> Secret key.
STRIPE_SECRET_KEY=

# Stripe Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=

# Stripe Product -> the recurring monthly Price id (starts with "price_").
STRIPE_PRO_PRICE_ID=

# Your deployed site origin, used to build Stripe redirect URLs, e.g.
# https://content-pilot.vercel.app (no trailing slash). Falls back to the
# request's own origin if unset.
PUBLIC_SITE_URL=
